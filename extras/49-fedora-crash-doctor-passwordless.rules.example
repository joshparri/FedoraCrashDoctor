/*
 * OPTIONAL AND NOT INSTALLED.
 * Copying this to /etc/polkit-1/rules.d/ makes Fedora Crash Doctor passwordless
 * for active local members of wheel. That is less secure: any process running
 * as that user could launch the locked-down broker without an authentication
 * prompt. The helper remains action-whitelisted, but the authentication barrier
 * is removed.
 */
polkit.addRule(function(action, subject) {
    if (action.id == "org.fedoracrashdoctor.helper" &&
        subject.active && subject.local && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
